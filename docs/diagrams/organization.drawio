        <mxCell id="leg-b1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="1128" width="36" height="36" as="geometry" /></mxCell>
        <mxCell id="leg-t1" value="&lt;b&gt;Org trail logs&lt;/b&gt;&lt;br&gt;The organization CloudTrail in the management account delivers every account's API activity to the central S3 bucket in log-archive." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="108" y="1124" width="920" height="48" as="geometry" /></mxCell>
        <mxCell id="leg-b2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="1190" width="36" height="36" as="geometry" /></mxCell>
        <mxCell id="leg-t2" value="&lt;b&gt;Config snapshots&lt;/b&gt;&lt;br&gt;The AWS Config recorder in every member account delivers configuration snapshots to the same KMS-encrypted log bucket." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="108" y="1186" width="920" height="48" as="geometry" /></mxCell>
        <mxCell id="leg-b3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="1252" width="36" height="36" as="geometry" /></mxCell>
        <mxCell id="leg-t3" value="&lt;b&gt;Delegated admin&lt;/b&gt;&lt;br&gt;AWS Organizations delegates GuardDuty, Security Hub and AWS Config administration to the security account." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="108" y="1248" width="920" height="48" as="geometry" /></mxCell>
        <mxCell id="leg-b4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1050" y="1128" width="36" height="36" as="geometry" /></mxCell>
        <mxCell id="leg-t4" value="&lt;b&gt;Findings&lt;/b&gt;&lt;br&gt;GuardDuty and Security Hub findings from every member account flow to the security account." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1098" y="1124" width="920" height="48" as="geometry" /></mxCell>
        <mxCell id="leg-b5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1050" y="1190" width="36" height="36" as="geometry" /></mxCell>
        <mxCell id="leg-t5" value="&lt;b&gt;Private subnets via RAM&lt;/b&gt;&lt;br&gt;The shared account owns the VPC and shares its private subnets with the workloads account through AWS RAM." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1098" y="1186" width="920" height="48" as="geometry" /></mxCell>
